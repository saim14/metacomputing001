{
  "experiment": {
    "id": "T1-U7B",
    "name": "Two-Hop Fresh-Stream Training-Stability Repair",
    "version": "0.10.0",
    "research_object": "Determine whether one fixed 2,000-update extension across four new two-hop data streams repairs the seed-level learning failure in T1-U7 while the task, model, causal controls, value target, and evaluation gates remain fixed."
  },
  "status": "passed_development_failed_fresh_confirmation",
  "hypotheses": {
    "learning_repair": "The fresh-stream extension raises every exposed development seed above the unchanged 0.95 clean-accuracy and 0.90 paired-counterfactual gates.",
    "invariance": "Both required-edge corruptions remain inside the fixed chance band and at least two intermediate steps retain the fixed continuous-value criterion.",
    "confirmation": "If and only if every development seed passes, the complete 6,000-update protocol will satisfy the same gate on all three fresh model seeds.",
    "null": "At least one development seed still fails, or a development-selected protocol fails fresh-seed confirmation."
  },
  "scientific_boundary": {
    "development_seeds_are_exposed": true,
    "development_seeds": [
      503,
      607,
      709
    ],
    "note": "T1-U7 outcomes and development samples are exposed. T1-U7B tests exactly one bounded intervention: a 2,000-update final-only extension using four new two-hop streams. Fresh model seeds remain unopened unless every exposed seed passes. No trajectory probe is fit."
  },
