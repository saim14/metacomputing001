  "experiment": {
    "id": "T1-U7C",
    "name": "Two-Hop Extension Training-Signal Repair",
    "version": "0.11.0",
    "research_object": "Determine whether retaining a small intermediate auxiliary loss during the fixed T1-U7B fresh-stream extension repairs the exposed seed-level optimization failures while every other task, model, schedule, control, target, and gate field remains fixed."
  },
  "status": "failed_development_gate_new_confirmation_seeds_unopened",
  "hypotheses": {
    "training_signal_repair": "An auxiliary-loss weight of 0.005 during the unchanged 2,000-update extension raises every exposed seed above the fixed 0.95 clean-accuracy and 0.90 paired-counterfactual gates.",
    "invariance": "Both required-edge corruptions remain inside the fixed chance band and at least two intermediate steps retain the fixed continuous-value criterion.",
    "confirmation": "If and only if all six exposed seeds pass, the complete protocol satisfies the same gate on all three newly reserved model seeds.",
    "null": "At least one exposed seed still fails, or the development-selected protocol fails new-seed confirmation."
  },
